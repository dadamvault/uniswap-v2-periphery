# ----------------------------------------------------------------------------
# Deployment config  (copy to .env and fill in)
# ----------------------------------------------------------------------------

# One of: kaia (8217) | bnb (BNB Chain, 56) | base (8453) | polygon (137)
# | arbitrum (Arbitrum One, 42161) — mainnet only, no testnets.
# Full list / RPCs / explorers: lib.js -> NETWORKS. REQUIRED, no default: every
# one of these moves real funds, so it's never implied.
NETWORK=

# Signing key: encrypted keystore only — no PRIVATE_KEY field here.
#   npm run create-keystore
# creates ./keystore.json (gitignored). Deploy/add-liquidity/smoke prompt for
# its password at the terminal each run; the password is never written to
# this file or anywhere else.

# Account allowed to call factory.setFeeTo / setFeeToSetter.
# Leave blank to use the deployer address.
# NOTE: this account permanently controls the developer-fee switch — use a
# secure key / multisig, not a throwaway.
FEE_TO_SETTER=

# Developer fee — Uniswap V2 protocol fee switch.
# When set, the deploy calls factory.setFeeTo(FEE_TO): 1/6 of the 0.1% swap
# fee is routed to this address as LP tokens (carved from the LP share, NOT
# added on top). Realise it per pair with removeLiquidity.
# Auto-applied only when the deployer IS FEE_TO_SETTER above; otherwise call
# setFeeTo later from the feeToSetter account. Blank = fee stays OFF.
FEE_TO=

# WETH address passed to the Router (the wrapped-native-coin token, e.g.
# WKAIA / WBNB / WETH / WPOL depending on NETWORK).
#   blank    -> canonical wrapped-native address for the selected network (recommended)
#   deploy   -> deploy the bundled contracts/test/WETH9.sol and use that
#   0x...    -> use this explicit address
WETH_ADDRESS=

# Optional RPC override (defaults to the public endpoint for NETWORK in lib.js)
RPC_URL=

# Path to the encrypted keystore file. Default: ./keystore.json (gitignored).
KEYSTORE_PATH=
